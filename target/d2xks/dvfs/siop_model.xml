<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE siop_document [
<!ELEMENT siop_document (temperatures, levels, components, scenarios?)>
<!ELEMENT temperatures (temp+)>
<!ELEMENT temp EMPTY>
<!ATTLIST temp
          type (AP|BAT|USB|CHG|PA|WIFI) #REQUIRED
          default CDATA "1"
          min CDATA "1"
          max CDATA "1"
          step CDATA "1"
          init CDATA "5"
          hold CDATA "1"
          gap CDATA "0">
<!ELEMENT levels (level+)>
<!ELEMENT level EMPTY>
<!ATTLIST level
          id CDATA #REQUIRED
          temp CDATA #REQUIRED>
<!ELEMENT components (component?)>
<!ELEMENT component (limiter+)>
<!ATTLIST component
          name CDATA #REQUIRED
          tempType CDATA #REQUIRED>
<!ELEMENT scenarios (scenario*, scenario_group*)>
<!ELEMENT scenario (limiter+)>
<!-- you can use below delimiter on scenario name -->
<!-- "!" : intent, ":" : package, "," : plural    -->
<!ATTLIST scenario
          name CDATA #REQUIRED
          tempType CDATA #REQUIRED
          priority CDATA "0">
<!ELEMENT scenario_group (scenario+)>
<!ELEMENT scenario EMPTY>
<!ATTLIST scenario
          name CDATA #REQUIRED
          limiter CDATA #REQUIRED
          step CDATA "-1"
          delay CDATA "0"
          cond (sensor_check|for_request|for_temporary) #IMPLIED
          temp CDATA "370"
          gap CDATA "20"
          value CDATA #REQUIRED>
<!ELEMENT limiter EMPTY>
<!ATTLIST limiter
          name CDATA #REQUIRED
          step CDATA "-1"
          delay CDATA "0"
          cond (sensor_check|for_request|for_temporary) #IMPLIED
          temp CDATA "370"
          gap CDATA "20"
          value CDATA #REQUIRED>
]>

<siop_document>

    <overheatcontrol>
        <complex>
            <LTB formula="AP*BAT" temp="520.420" />
            <GDM formula="AP*BAT" temp="475.400" />
            <GDMLTB formula="AP*BAT" temp="470.430"/>
            <SS  formula="AP*BAT*PA" temp="580.450.590" />
        </complex>
    </overheatcontrol>

    <modelsettings>
        <sensors>
            <LTB_SENSOR type="(PALM*LIGHT*FLICKER)+(POSITION*LIGHT*FLICKER)" />
        </sensors>
    </modelsettings>

    <components>

        <component name="AP" tempType="LRP" >
            <limiter name="CPUFreqMax" step="0" temp="350:380:450:470" value="-1:1378000:1378000:1248000" />
            <limiter name="GPUFreqMax" step="0" temp="350:380:450:470" value="-1:377000:377000:260000" />
        </component>

        <component name="DISPLAY" tempType="LRP">
            <limiter name="Brightness" temp="390" gap="20" value="-1:201:144" />
            <limiter name="MultiWindow" temp="450:470:500" value="-1:1:1" delay="0:300:0" />
        </component>

        <component name="WIFI" tempType="LRP">
            <limiter name="SmartBonding" temp="440" value="-1:1" />
        </component>

        <component name="CHG+DISPLAY" tempType="LRP*BAT">
            <limiter name="Charging" temp="0.310:330.330" value="-1:70" />
        </component>

        <component name="CAM" tempType="LRP">
            <limiter name="VideoLowPowerMode" temp="350" value="-1:1" />
        </component>

    </components>

    <scenarios>

        <scenario name="Heavyuser" tempType="LRP" priority="1" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="550" value="-1" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="430:480" value="-1:572000" />
        </scenario>

        <scenario name="AppStart" tempType="AP" priority="2" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="550:600:620" value="-1:1378000:1248000" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="550:600"     value="-1:377000" />
        </scenario>

        <scenario name="Badge" tempType="AP" priority="2" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="550:600:620" value="-1:1378000:1248000" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="550:600"     value="-1:377000" />
        </scenario>

        <scenario name="WakeUp" tempType="AP" priority="2" >
            <limiter name="CPUFreqMax" cond="for_temporary" temp="550:600:620" value="-1:1378000:1248000" />
            <limiter name="GPUFreqMax" cond="for_temporary" temp="550:600"     value="-1:377000" />
        </scenario>

        <scenario name="Navigation" tempType="LRP" >
            <limiter name="Brightness" temp="410" gap="20" value="169:144" />
        </scenario>

        <scenario name="MultiWindow" tempType="LRP" priority="1">
            <limiter name="CPUFreqMax" step="0" temp="350:380:410:430" value="-1:1378000:1378000:1040000" />
        </scenario>

        <scenario name="Dex" tempType="LRP" priority="1">
            <limiter name="CPUFreqMax" step="0" temp="350:380:410:430" value="-1:1378000:1378000:1040000" />
        </scenario>

        <scenario name="CameraNight!Camera_night" tempType="AP">
            <limiter name="CPUFreqMax" value="-1" />
            <limiter name="GPUFreqMax" value="-1" />
        </scenario>

        <scenario name="CameraRecording!Camera_recording,Camera_recordingDual" tempType="LRP" priority="1" >
            <limiter name="CPUFreqMax" step="0" temp="350:380" value="-1:1560000" />
            <limiter name="GPUFreqMax" step="0" temp="350:380" value="-1:433000"  />
            <limiter name="Brightness" temp="330:350:410:430" value="-1:255:201:144" />
        </scenario>

        <scenario name="CameraRecordingUHD60fps!Camera_recording_UHD60fps" tempType="LRP" priority="2" >
            <limiter name="Brightness" temp="410" value="201:144" />
        </scenario>

        <scenario name="CameraLiveFocusPreview!Camera_preview_LiveFocusVideo" tempType="LRP" priority="2" >
            <limiter name="GPUFreqMax" step="0" temp="350:380" value="-1:572000"  />
        </scenario>

        <scenario name="CameraLiveFocusRecording!Camera_recording_LiveFocusVideo" tempType="LRP" priority="2" >
            <limiter name="Brightness" temp="370" value="201:144" />
        </scenario>

        <scenario name="ARemoji:com.samsung.android.aremoji" tempType="AP" >
            <limiter name="GPUFreqMax" value="377000" />
        </scenario>

        <scenario name="VtCallControl" tempType="LRP" priority="1">
            <limiter name="Brightness" temp="410" value="201:144" />
            <limiter name="CameraFps"       temp="360" value="-1:1" />
        </scenario>

        <scenario name="LiveCam" tempType="LRP" priority="1">
            <limiter name="Brightness" temp="410" value="201:144" />
            <limiter name="CameraFps"       temp="360" value="-1" />
        </scenario>

        <scenario name="PowerSharing" tempType="LRP" priority="3" >
            <limiter name="CPUFreqMax" temp="350:380" value="1560000:1378000" />
            <limiter name="GPUFreqMax" value="377000" />
        </scenario>

        <scenario name="SpayClockLimit" tempType="LRP" priority="2" >
            <limiter name="CPUFreqMax" temp="350:380" value="2080000:1378000" />
        </scenario>

        <scenario name="AppStore" tempType="LRP" >
            <limiter name="Charging" value="70" />
            <limiter name="WifiTput" temp="310:330:350:390:410:430" value="-1:150:100:50:30:10" />
        </scenario>

        <scenario name="LowTemp" tempType="BAT" priority="3" >
            <limiter name="CPUFreqMax" temp="-150:-70:-50" value="1664000:1976000:-1" />
        </scenario>

        <scenario name="EarlySIP" tempType="LRP" priority="1">
            <limiter name="CPUFreqMax" temp="370:390" value="-1:1560000" />
        </scenario>

        <scenario name="SIP" tempType="LRP*BAT" priority="1">
            <limiter name="CPUFreqMax" temp="370.0:390.0:410.360:420.380" value="-1:1560000:1456000:1378000" />
        </scenario>

        <scenario name="FotaDownload:com.wssyncmldm" tempType="LRP" >
            <limiter name="Charging" value="0" />
        </scenario>

        <scenario name="SmartSwitch" tempType="LRP" >
            <limiter name="CPUFreqMax" step="0" temp="350:380" value="2236000:1378000" />
        </scenario>

        <scenario_group name="GameThermalCpuControl" tempType="LRP" >
            <scenario id="-7"  limiter="CPUFreqMax"                   value="728000" />
            <scenario id="-6"  limiter="CPUFreqMax" step="0" temp="370:380:400" value="-1:1378000:728000" />
            <scenario id="-5"  limiter="CPUFreqMax" step="0" temp="370:380:400" value="-1:1378000:819000" />
            <scenario id="-4"  limiter="CPUFreqMax" step="0" temp="370:380:400" value="-1:1378000:936000" />
            <scenario id="-3"  limiter="CPUFreqMax" step="0" temp="370:380:400" value="-1:1378000:1040000" />
            <scenario id="-2"  limiter="CPUFreqMax" step="0" temp="370:380:400" value="-1:1378000:1144000" />
            <scenario id="-1"  limiter="CPUFreqMax" step="0" temp="370:380:400" value="-1:1378000:1248000" />
            <scenario id="0"   limiter="CPUFreqMax" step="0" temp="370:380:400" value="-1:1456000:1378000" />
            <scenario id="1"   limiter="CPUFreqMax" step="0" temp="370:380:400" value="-1:1560000:1456000" />
            <scenario id="2"   limiter="CPUFreqMax" step="0" temp="370:380:400" value="-1:1664000:1560000" />
            <scenario id="3"   limiter="CPUFreqMax" step="0" temp="370:380:400" value="-1:1820000:1664000" />
            <scenario id="4"   limiter="CPUFreqMax"                             value="-1" />
            <scenario name="BackgroundCpuset" temp="380:400:420" value="100:200:300" />
        </scenario_group>

        <scenario_group name="GameThermalGpuControl" tempType="LRP" >
            <scenario id="-3" limiter="GPUFreqMax"                     value="260000" />
            <scenario id="-2" limiter="GPUFreqMax" step="0" temp="370:380:400" value="-1:325000:260000" />
            <scenario id="-1" limiter="GPUFreqMax" step="0" temp="370:380:400" value="-1:377000:325000" />
            <scenario id="0"  limiter="GPUFreqMax" step="0" temp="370:380:400" value="-1:433000:377000" />
            <scenario id="1"  limiter="GPUFreqMax" step="0" temp="370:380:400" value="-1:572000:433000" />
            <scenario id="2"  limiter="GPUFreqMax" step="0" temp="370:380:400" value="-1:650000:572000" />
            <scenario id="3"  limiter="GPUFreqMax"                                         value="-1" />
        </scenario_group>

    </scenarios>

</siop_document>